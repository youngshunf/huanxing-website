# 生产环境（nginx 反代，使用相对路径）
VITE_API_BASE_URL=/api/v1
# 网页发布制品内容域（iframe/解锁直连）：**必须是 usercontent 隔离域，不能是官网域或 API 域**。
# 制品在这里拿到 allow-same-origin 才能用 localStorage；而该域上没有登录态、没有 /api/ 反代
# （nginx 只反代 /s/*），所以同源能读到的只有制品自己的数据。指回 api.* 或 astra 会让制品
# 同源读到主人的 cookie 并能以主人身份调 API——那正是这个域存在的原因。
VITE_SHARE_CONTENT_ORIGIN=https://usercontent.dcfuture.cn
